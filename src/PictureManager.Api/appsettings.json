{
  "ConnectionStrings": {
    "PictureManagerDb": "Host=localhost;Port=5432;Database=picturemanager;Username=picturemanager;Password=picturemanager"
  },
  "ThumbnailCache": {
    "PreviewEnabled": true
  },
  "FaceRecognition": {
    "ModelDirectory": "../../models/buffalo_l"
  },
  "Scanning": {
    "SupportedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".tif", ".tiff", ".heic", ".heif" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/picturemanager-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
