# Copy to .env (gitignored) and change POSTGRES_PASSWORD before running docker-compose anywhere
# but a local developer workstation — see the warning comment at the top of docker-compose.yml.
POSTGRES_DB=picturemanager
POSTGRES_USER=picturemanager
POSTGRES_PASSWORD=picturemanager

# Initial password for the "admin" account (docker-compose.prod.yml requires it); changed at first login.
PM_ADMIN_PASSWORD=
