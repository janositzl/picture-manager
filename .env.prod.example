# Copy to .env (gitignored) next to docker-compose.prod.yml and fill in real values
# before running: docker compose -f docker-compose.prod.yml up -d --build

# --- PostgreSQL ---
POSTGRES_DB=picturemanager
POSTGRES_USER=picturemanager
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- API ---
# Host port the API is published on (container always listens on 8080 internally).
API_PORT=5080

# Absolute host path to your photo library. Mounted read-only into the container.
IMAGE_LIBRARY_PATH=/absolute/path/to/your/photos
# Name shown for this root in the UI/API.
IMAGE_ROOT_NAME=library
